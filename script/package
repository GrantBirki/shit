#!/usr/bin/env bash

set -euo pipefail

source script/env "$@"
source "$DIR/script/lib/common.sh"

require_macos error "Packaging requires macOS."
ensure_full_xcode
require_tool xcodebuild "xcodebuild not found. Install Xcode or Command Line Tools."
require_tool ditto "ditto not found."

CONFIGURATION="${CONFIGURATION:-Release}"

if [[ "${SKIP_UPDATE:-}" != "1" ]]; then
  script/update
fi
set_xcodebuild_vars

if [[ "$VERSION" == "unknown" ]]; then
  echo -e "${RED}VERSION file missing or empty.${OFF}"
  exit 1
fi

if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo -e "${RED}VERSION must be in X.Y.Z format; got ${VERSION}.${OFF}"
  exit 1
fi

PROJECT_PATH=$(find_project)

DIST_DIR="${DIST_DIR:-$DIR/dist}"
STAGING_DIR="${STAGING_DIR:-$DIR/build/package}"
if [[ "$APP_NAME" == */* ]]; then
  echo -e "${RED}APP_NAME must be a file name.${OFF}"
  exit 1
fi
mkdir -p "$STAGING_DIR" "$DIST_DIR"
PACKAGE_DIR=$(mktemp -d "$STAGING_DIR/.package.XXXXXXXX")
trap 'rm -rf -- "$PACKAGE_DIR"' EXIT
STAGING_APP="$PACKAGE_DIR/${APP_NAME}.app"
NOTARY_ZIP="$PACKAGE_DIR/${APP_NAME}-notary.zip"

CODESIGN_IDENTITY="${CODESIGN_IDENTITY:-}"
NOTARY_PROFILE="${NOTARY_PROFILE:-}"
ENTITLEMENTS_PATH="${ENTITLEMENTS_PATH:-}"

if [[ -z "$ENTITLEMENTS_PATH" && -f "$DIR/${APP_NAME}.entitlements" ]]; then
  ENTITLEMENTS_PATH="$DIR/${APP_NAME}.entitlements"
fi

echo -e "${BLUE}Packaging ${APP_NAME} (${CONFIGURATION})...${OFF}"

xcodebuild \
  -project "$PROJECT_PATH" \
  -scheme "$SCHEME" \
  -configuration "$CONFIGURATION" \
  -derivedDataPath "$DERIVED_DATA" \
  build \
  CODE_SIGNING_ALLOWED=NO \
  ENABLE_CODE_COVERAGE=NO \
  CLANG_COVERAGE_MAPPING=NO \
  ARCHS=arm64 \
  ONLY_ACTIVE_ARCH=NO \
  MARKETING_VERSION="$VERSION" \
  CURRENT_PROJECT_VERSION="$VERSION" \
  GIT_SHA="$GIT_SHA"

APP_PATH="$DERIVED_DATA/Build/Products/${CONFIGURATION}/${APP_NAME}.app"
if [[ ! -d "$APP_PATH" ]]; then
  echo -e "${RED}App not found at $APP_PATH${OFF}"
  exit 1
fi

ditto "$APP_PATH" "$STAGING_APP"

if [[ -n "$NOTARY_PROFILE" && -z "$CODESIGN_IDENTITY" ]]; then
  echo -e "${RED}NOTARY_PROFILE is set, but CODESIGN_IDENTITY is empty.${OFF}"
  exit 1
fi

require_tool codesign "codesign not found."

codesign_args=(--force --options runtime)
if [[ -n "$CODESIGN_IDENTITY" ]]; then
  codesign_args+=(--timestamp --sign "$CODESIGN_IDENTITY")
else
  echo -e "${BLUE}Ad-hoc signing ${APP_NAME}.app...${OFF}"
  codesign_args+=(--sign -)
fi
if [[ -n "$ENTITLEMENTS_PATH" ]]; then
  if [[ ! -f "$ENTITLEMENTS_PATH" ]]; then
    echo -e "${RED}Entitlements file not found at $ENTITLEMENTS_PATH${OFF}"
    exit 1
  fi
  codesign_args+=(--entitlements "$ENTITLEMENTS_PATH")
fi
codesign "${codesign_args[@]}" "$STAGING_APP"

codesign --verify --deep --strict "$STAGING_APP"

if [[ -n "$NOTARY_PROFILE" ]]; then
  require_tool xcrun "xcrun not found."
  ditto -c -k --sequesterRsrc --keepParent "$STAGING_APP" "$NOTARY_ZIP"
  xcrun notarytool submit "$NOTARY_ZIP" --wait --keychain-profile "$NOTARY_PROFILE"
  xcrun stapler staple "$STAGING_APP"
  codesign --verify --deep --strict "$STAGING_APP"
fi

for output in "$DIST_DIR/${APP_NAME}.zip" "$DIST_DIR/${APP_NAME}.zip.sha256"; do
  if [[ -d "$output" && ! -L "$output" ]]; then
    echo -e "${RED}Expected a file at $output, found a directory.${OFF}"
    exit 1
  fi
done

OUTPUT_DIR=$(mktemp -d "$DIST_DIR/.package.XXXXXXXX")
trap 'rm -rf -- "$PACKAGE_DIR" "$OUTPUT_DIR"' EXIT
ZIP_PATH="$OUTPUT_DIR/${APP_NAME}.zip"
ditto -c -k --sequesterRsrc --keepParent "$STAGING_APP" "$ZIP_PATH"
SHA=$(shasum -a 256 "$ZIP_PATH" | awk '{print $1}')
echo "$SHA" > "${ZIP_PATH}.sha256"

# Serialize publishers and invalidate the old checksum before replacing its archive.
lockf -kn "$DIST_DIR" bash -es -- "$DIST_DIR" "$ZIP_PATH" <<'PUBLISH'
dist_dir=$1
zip_path=$2
rm -f -- "$dist_dir/${zip_path##*/}.sha256"
mv -f -- "$zip_path" "$dist_dir/"
mv -f -- "${zip_path}.sha256" "$dist_dir/"
PUBLISH

echo -e "${GREEN}OK${OFF} - Created $DIST_DIR/${APP_NAME}.zip"
echo -e "${GREEN}OK${OFF} - SHA256 $SHA"
